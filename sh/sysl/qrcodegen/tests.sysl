module sh.sysl.qrcodegen
@tests

// What this binding claims, run by `sysl test .`.
//
// **The strongest tests here compare a whole symbol against two other implementations of the
// standard.** The grids below are what both [segno](https://pypi.org/project/segno/) and
// [qrcode](https://pypi.org/project/qrcode/) produce -- two Python encoders sharing no code with
// qrcodegen or with each other -- at a fixed version, correction level and mask, so that three
// conforming encoders must agree module for module. That is a real oracle rather than a restatement:
// a binding that passed the wrong correction level, mis-ordered the mode indicators, or let a mask
// constant wrap would produce a valid-looking symbol carrying something else, and every structural
// test in this file would still pass.
//
// **Two references rather than one, because the first pair disagreed.** Sixteen digits is exactly the
// numeric capacity of a version 1 quartile symbol, and there segno produces a different grid from the
// other two; fifteen digits agree everywhere. Which of them is right is segno's question rather than
// this package's -- what settled it here was asking a third encoder, and the lesson is that a single
// oracle is an opinion.
//
// The rest is about the seam. qrcodegen is handed pointers and never a length, so **every bound in
// this package is one nothing underneath it would notice** -- a slice a byte too short is not a
// refusal in C, it is a write past the end. Those checks are this file's own and are tested from both
// sides: the exact size works, one less is `Short`.

// -- Against another implementation of the standard --------------------------------------------------

// `HELLO WORLD` at medium correction, version 1, mask 0. Alphanumeric mode: eleven characters at
// eleven bits per two.
private hello_world_m1_mask0() -> []string = [
    "111111100010101111111",
    "100000101110001000001",
    "101110100010101011101",
    "101110100010101011101",
    "101110101011101011101",
    "100000100111001000001",
    "111111101010101111111",
    "000000000000000000000",
    "101010100100100010010",
    "011110001001000010001",
    "000111111101001011000",
    "111101011001110101110",
    "010011110101001110101",
    "000000001010001000101",
    "111111100000100101100",
    "100000100110001101000",
    "101110101100101111111",
    "101110100011010100010",
    "101110101111011101001",
    "100000100001110001011",
    "111111101101011100001",
]

// Fifteen digits at quartile correction, version 1, mask 3. **Numeric mode**, which is the arm the
// first grid does not reach -- ten bits per three digits, and a different mode indicator in the
// stream. Fifteen rather than sixteen because sixteen is exactly this symbol's numeric capacity, and
// the reference encoders part company there.
private digits_q1_mask3() -> []string = [
    "111111100010101111111",
    "100000101101101000001",
    "101110101101001011101",
    "101110100011101011101",
    "101110100101101011101",
    "100000100110101000001",
    "111111101010101111111",
    "000000000100000000000",
    "011101100100000000110",
    "000110010001011101100",
    "110101100101100000010",
    "110101001101101011010",
    "111100100100000100000",
    "000000001110101010001",
    "111111100010100000101",
    "100000101101000110011",
    "101110100011011111101",
    "101110101011001011010",
    "101110101010101000000",
    "100000101100010100111",
    "111111100100010010110",
]

// Whether an encode failed for a particular reason. **`Error` carries payloads in two of its arms**,
// so it is not an `Eq` enum and a refusal cannot be compared with `==`; a `match` per assertion would
// bury the point of each test in its scaffolding, so the four questions the tests actually ask are
// named here once.

private is_too_long(r: Result[Qr, Error]) -> bool = r match
    Err(TooLong) -> true
    _            -> false

private is_bad_version(r: Result[Qr, Error]) -> bool = r match
    Err(BadVersion) -> true
    _               -> false

private is_bad_mask(r: Result[Qr, Error]) -> bool = r match
    Err(BadMask) -> true
    _            -> false

// The size a refusal says would have been enough, which is the half of `Short` worth asserting.
private short_needed(r: Result[Qr, Error]) -> Option[usize] = r match
    Err(Short(n)) -> Some(n)
    _             -> None

// Where a zero byte was found.
private nul_at(r: Result[Qr, Error]) -> Option[usize] = r match
    Err(InteriorNul(at)) -> Some(at)
    _                    -> None

// Compares a symbol against a grid module for module, and says where it first differs rather than
// only that it does.
private assert_grid(qr: Qr, want: []string)
    assert_eq(qr.size(), int(want.len))

    for y in 0..<want.len
        for x in 0..<want.len
            assert_eq(qr.dark(int(x), int(y)), want[y].bytes[x] == u8('1'),
                      f"the module at ${x}, ${y}")
end assert_grid

@test("an alphanumeric payload matches two other encoders' symbol, module for module")
alphanumeric_matches_segno()
    var scratch: []u8 = [0; 4096]
    var out: []u8 = [0; 4096]

    // `boost_ecl` off, because raising the level for free would change the symbol and the reference
    // was made without it.
    val qr = encode("HELLO WORLD", scratch, out, ecl = Medium,
                    min_version = 1, max_version = 1,
                    mask = Pattern(0), boost_ecl = false).expect("eleven characters fit version 1")

    assert_grid(qr, hello_world_m1_mask0())
end alphanumeric_matches_segno

@test("a numeric payload matches two other encoders' symbol, module for module")
numeric_matches_segno()
    var scratch: []u8 = [0; 4096]
    var out: []u8 = [0; 4096]

    val qr = encode("012345678901234", scratch, out, ecl = Quartile,
                    min_version = 1, max_version = 1,
                    mask = Pattern(3), boost_ecl = false).expect("fifteen digits fit version 1")

    assert_grid(qr, digits_q1_mask3())
end numeric_matches_segno

// -- Mode selection is doing something ----------------------------------------------------------------

// **The reason `encode` goes through the shim rather than forcing byte mode.** The same forty digits
// take ten bits per three in numeric mode and eight bits each as bytes, which is the difference
// between one symbol size and another. A binding that quietly lost mode selection would pass every
// other test in this file.
@test("digits encode denser than the same digits as bytes")
numeric_is_denser_than_bytes()
    val digits = "0123456789012345678901234567890123456789"

    var scratch: []u8 = [0; 4096]
    var out: []u8 = [0; 4096]

    val chosen = encode(digits, scratch, out).expect("forty digits encode")
    val chosen_version = chosen.version()

    var scratch2: []u8 = [0; 4096]
    var out2: []u8 = [0; 4096]

    val forced = encode_binary(digits.bytes, scratch2, out2).expect("and so do forty bytes")

    assert(chosen_version < forced.version(),
           f"numeric picked version ${chosen_version}, byte mode ${forced.version()}")
end numeric_is_denser_than_bytes

// The encoder chooses the smallest symbol that fits, so a longer payload is never a smaller symbol.
@test("the version rises with the payload, and reads back from the size")
version_follows_the_payload()
    var scratch: []u8 = [0; 8192]
    var out: []u8 = [0; 4096]

    val small = encode("SYSL", scratch, out).expect("four characters encode")

    assert_eq(small.version(), 1)
    assert_eq(small.size(), 21)

    var scratch2: []u8 = [0; 8192]
    var out2: []u8 = [0; 4096]

    val big = encode("SYSL IS A SYSTEMS LANGUAGE WITH ONE LLVM BACKEND AND NO RUNTIME TO SPEAK OF",
                     scratch2, out2).expect("seventy-five characters encode too")

    assert(big.version() > small.version())

    // The two are the same question asked twice, and a symbol's side length is what defines its
    // version -- so they must agree or one of them is wrong.
    assert_eq(big.size(), big.version() * 4 + 17)
end version_follows_the_payload

// -- Binary payloads ----------------------------------------------------------------------------------

// `encode_binary` is told the length, so a zero byte is ordinary payload rather than a terminator.
// This is the case `encode` refuses by name, and the reason both calls exist.
@test("a zero byte is payload to encode_binary and a refusal to encode")
zero_bytes_are_binary_payload()
    val data: []const u8 = [0x00, 0xFF, 0x00, 0x10, 0x00]

    var scratch: []u8 = [0; 4096]
    var out: []u8 = [0; 4096]

    assert(encode_binary(data, scratch, out).is_ok(), "binary carries the zeroes")

    var scratch2: []u8 = [0; 4096]
    var out2: []u8 = [0; 4096]

    // The offset matters: told only that something was wrong, a caller cannot tell a zero byte from
    // a payload that was too long.
    assert_eq(nul_at(encode_bytes(data, scratch2, out2))
                  .expect("mode selection cannot see past a zero byte and must say so"), 0)

    val late: []const u8 = [u8('A'), u8('B'), 0x00, u8('C')]

    assert_eq(nul_at(encode_bytes(late, scratch2, out2)).expect("and it must say where"), 2)
end zero_bytes_are_binary_payload

// An empty payload is a real symbol -- the smallest one there is -- and it is also the case where the
// shim's copy has a null source, which ISO C leaves undefined for `memcpy` even at zero length.
@test("an empty payload is the smallest symbol rather than an error")
empty_payload_encodes()
    var scratch: []u8 = [0; 4096]
    var out: []u8 = [0; 4096]

    val qr = encode("", scratch, out).expect("nothing is a payload")

    assert_eq(qr.version(), 1)

    val nothing: []const u8 = []

    var scratch2: []u8 = [0; 4096]
    var out2: []u8 = [0; 4096]

    assert(encode_binary(nothing, scratch2, out2).is_ok())
end empty_payload_encodes

// -- The bounds this package owns -----------------------------------------------------------------

// **Both sizes are asserted from both sides.** qrcodegen is never told how long either slice is, so
// these two checks are all that stands between a caller's arithmetic and a write past the end -- and
// a bound that were merely generous would pass a test that only tried the exact size.
@test("the output slice is sized exactly, and one byte less is refused with the figure")
out_is_bounded_exactly()
    val room = buffer_len(4)

    assert_eq(room, 138)

    var scratch: []u8 = [0; 4096]
    var out: []u8 = [0; 4096]

    assert(encode("SYSL", scratch, out[0..<room], max_version = 4).is_ok(),
           "exactly buffer_len(4) is enough")

    assert_eq(short_needed(encode("SYSL", scratch, out[0..<room - 1], max_version = 4))
                  .expect("one byte less must be refused as Short"), room)
end out_is_bounded_exactly

@test("the scratch slice is sized exactly, and one byte less is refused with the figure")
scratch_is_bounded_exactly()
    val payload = "SYSL"
    val working = scratch_len(payload.bytes.len, 4)

    // The payload, its terminator, and the encoder's own temporary buffer.
    assert_eq(working, payload.bytes.len + 1 + buffer_len(4))

    var scratch: []u8 = [0; 4096]
    var out: []u8 = [0; 4096]

    assert(encode(payload, scratch[0..<working], out, max_version = 4).is_ok(),
           "exactly scratch_len is enough")

    assert_eq(short_needed(encode(payload, scratch[0..<working - 1], out, max_version = 4))
                  .expect("one byte less must be refused as Short"), working)
end scratch_is_bounded_exactly

// -- The refusals -----------------------------------------------------------------------------------

@test("a payload too large for the version range is refused rather than truncated")
too_long_is_refused()
    var scratch: []u8 = [0; 8192]
    var out: []u8 = [0; 4096]

    // Version 1 at high correction holds ten alphanumeric characters.
    assert(is_too_long(encode("HELLO WORLD, WHICH IS FAR MORE THAN A VERSION 1 SYMBOL HOLDS",
                              scratch, out, ecl = High, min_version = 1, max_version = 1)))

    // And the same payload is fine given room, which is what says the refusal was about capacity
    // rather than about the payload.
    assert(encode("HELLO WORLD, WHICH IS FAR MORE THAN A VERSION 1 SYMBOL HOLDS",
                  scratch, out, ecl = High).is_ok())
end too_long_is_refused

@test("a version outside the standard's range is refused")
bad_version_is_refused()
    var scratch: []u8 = [0; 8192]
    var out: []u8 = [0; 4096]

    assert(is_bad_version(encode("SYSL", scratch, out, min_version = 0)))
    assert(is_bad_version(encode("SYSL", scratch, out, max_version = 41)))
    assert(is_bad_version(encode("SYSL", scratch, out, min_version = 10, max_version = 5)))

    // The boundaries themselves are legal, which is the half an off-by-one would break.
    assert(encode("SYSL", scratch, out, min_version = 1, max_version = 40).is_ok())
end bad_version_is_refused

@test("a mask outside the standard's eight patterns is refused rather than taken modulo eight")
bad_mask_is_refused()
    var scratch: []u8 = [0; 8192]
    var out: []u8 = [0; 4096]

    assert(is_bad_mask(encode("SYSL", scratch, out, mask = Pattern(8))))
    assert(is_bad_mask(encode("SYSL", scratch, out, mask = Pattern(-1))),
           "-1 is how C spells automatic, and must not arrive that way through Pattern")

    assert(encode("SYSL", scratch, out, mask = Pattern(0)).is_ok())
    assert(encode("SYSL", scratch, out, mask = Pattern(7)).is_ok())
end bad_mask_is_refused

// -- Reading a finished symbol ----------------------------------------------------------------------

// The quiet zone: the standard requires four light modules around a symbol, and qrcodegen answers
// light outside its bounds so a renderer can sweep the larger area without a bounds test. That is
// behaviour this package promises in `dark`'s own comment, so it is behaviour worth pinning.
@test("outside the symbol is light, so a quiet zone needs no bounds test")
outside_is_light()
    var scratch: []u8 = [0; 4096]
    var out: []u8 = [0; 4096]

    val qr = encode("SYSL", scratch, out).expect("four characters encode")

    val n = qr.size()

    assert(!qr.dark(-1, -1))
    assert(!qr.dark(n, n))
    assert(!qr.dark(0, -4))
    assert(!qr.dark(n + 3, 0))

    // Every symbol has a finder pattern in three of its corners: a dark 7x7 ring with a dark 3x3
    // centre. Fixed by the standard, so it holds whatever the payload is.
    for corner in [(0, 0), (n - 7, 0), (0, n - 7)]
        val (cx, cy) = corner

        assert(qr.dark(cx, cy), "the finder's outer ring")
        assert(!qr.dark(cx + 1, cy + 1), "the light ring inside it")
        assert(qr.dark(cx + 3, cy + 3), "and the dark centre")

    // The fourth corner has no finder, which is what orients a scanner.
    assert(!qr.dark(n - 1, n - 1))
end outside_is_light
